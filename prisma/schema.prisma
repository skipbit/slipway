// Prisma schema — Postgres everywhere (local dev via docker compose + prod).
// DATABASE_URL points at the compose `db` service; see .env.example.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Connection URL lives in prisma.config.ts (Prisma 7 removed datasource `url`
  // from the schema); the runtime client connects via the pg driver adapter in
  // lib/prisma.ts.
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts    Account[]
  sessions    Session[]
  emailTokens EmailToken[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// What a mailed single-use secret is for. One table rather than one per
// purpose: password reset and email verification differ only in their TTL and
// in what redeeming them does, so a second table would have been a copy of this
// one plus a copy of every statement that touches it.
enum EmailTokenPurpose {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

// Single-use secrets sent by email. Only the SHA-256 of the token is stored —
// the plaintext exists solely in the message that carried it, so a dump of this
// table yields nothing an attacker can present back to the app. Rows are
// deleted the moment they are redeemed, and `@@unique([userId, purpose])` makes
// "at most one live link per user per purpose" the database's rule rather than
// something the application remembers — issuing is then a single upsert, and
// asking for a new reset link still does not touch a pending verification.
// Expired-but-unclicked rows are reclaimed by cleanupExpiredEmailTokens() in
// lib/email-token.ts.
model EmailToken {
  id        String            @id @default(cuid())
  userId    String
  purpose   EmailTokenPurpose
  tokenHash String            @unique
  // Timestamptz for the same reason as RateLimit.expiresAt: the comparison
  // must not depend on the DB session's TimeZone.
  expiresAt DateTime          @db.Timestamptz(3)
  createdAt DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, purpose])
  @@index([expiresAt])
}

// Fixed-window rate limiting for auth actions. One row per bucket key
// (e.g. "login:<ip>"); the atomic upsert in lib/rate-limit.ts resets the
// window in place once expiresAt passes, so the table only grows by the
// number of distinct callers, not by request volume.
model RateLimit {
  key       String   @id
  count     Int      @default(0)
  // Timestamptz so the `expiresAt < now()` comparison in lib/rate-limit.ts is
  // exact regardless of the DB session's TimeZone.
  expiresAt DateTime @db.Timestamptz(3)

  @@index([expiresAt])
}

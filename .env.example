# Copy this file to .env and fill in the values.
#   cp .env.example .env

# --- App ---
# Public base URL of the app (used in metadata and absolute URLs).
# NEXT_PUBLIC_* is inlined at BUILD time — for the production image it is a
# build arg, not a runtime setting.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Base URL for links that leave the app (password reset emails). No
# NEXT_PUBLIC_ prefix, so this one is read at runtime and can differ per deploy.
# Falls back to NEXT_PUBLIC_APP_URL — which in a prebuilt image usually means
# localhost, i.e. reset links nobody can open. Set it in production.
APP_URL=""

# --- Database (Prisma / Postgres) ---
# Postgres everywhere. `docker compose up` starts a matching db service.
# From your host machine the db is on localhost; inside the compose network the
# app talks to it as host `db` (compose overrides this value automatically).
DATABASE_URL="postgresql://slipway:slipway@localhost:5432/slipway?schema=public"

# --- Auth.js (NextAuth v5) ---
# Required. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Google OAuth (optional — email/password works without it)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Email (password reset) ---
# Optional. Leave blank and the reset link is printed to the server log instead
# of being emailed — enough to exercise the whole flow locally with nothing to
# sign up for. Set both before real users touch this.
# Get a key at https://resend.com. EMAIL_FROM must be on a domain you verified
# there, e.g. "Slipway <hello@yourdomain.com>" — resend.com's shared
# onboarding@resend.dev only delivers to your own account address.
# Both or neither: with a key but no sender the console fallback switches off
# and every send fails at the provider, which the user never sees.
RESEND_API_KEY=""
EMAIL_FROM=""
